# Include license and readme
include LICENSE
include README.md

# Vendored tree-sitter grammar, compiled into ox._grammar by setup.py
include src/ox/_grammar.c
include tree-sitter-ox/src/parser.c
include tree-sitter-ox/src/tree_sitter/*.h

# Exclude unnecessary files
global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store
