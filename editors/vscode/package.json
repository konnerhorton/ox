{
  "name": "ox-training-log",
  "displayName": "Ox",
  "description": "Syntax highlighting and diagnostics for Ox training log files",
  "version": "0.1.0",
  "publisher": "konnerhorton",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/konnerhorton/ox",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/konnerhorton/ox/issues"
  },
  "homepage": "https://konnerhorton.github.io/ox/editor-support/",
  "galleryBanner": {
    "color": "#673AB7",
    "theme": "dark"
  },
  "keywords": [
    "ox",
    "training log",
    "workout",
    "fitness",
    "strength training",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ox",
        "aliases": [
          "Ox",
          "ox"
        ],
        "extensions": [
          ".ox"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ox",
        "scopeName": "source.ox",
        "path": "./syntaxes/ox.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Ox Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ox-dark.json"
      }
    ],
    "configuration": {
      "title": "Ox",
      "properties": {
        "ox.lsp.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ox-lsp` executable. When empty, the extension looks for a project `.venv` near the open file, then for `ox-lsp` on your `PATH`."
        }
      }
    },
    "commands": [
      {
        "command": "ox.restartLsp",
        "title": "Restart Language Server",
        "category": "Ox"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
